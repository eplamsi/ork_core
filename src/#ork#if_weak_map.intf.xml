<?xml version="1.0" encoding="utf-8"?>
<abapGit version="v1.0.0" serializer="LCL_OBJECT_INTF" serializer_version="v1.0.0">
 <asx:abap xmlns:asx="http://www.sap.com/abapxml" version="1.0">
  <asx:values>
   <VSEOINTERF>
    <CLSNAME>/ORK/IF_WEAK_MAP</CLSNAME>
    <LANGU>E</LANGU>
    <DESCRIPT>WeakMap&lt;string, object&gt;</DESCRIPT>
    <EXPOSURE>2</EXPOSURE>
    <STATE>1</STATE>
    <UNICODE>5</UNICODE>
   </VSEOINTERF>
   <DESCRIPTIONS>
    <SEOCOMPOTX>
     <CMPNAME>CLEAN_UP</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Removes mappings of garbage collected objects</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>CLEAR</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Removes all mappings</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Retrieves an object for the specified key.</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>KEYS</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Returns all keys of the mapping</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>REMOVE</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Removes the mapping for the specified key, if it exists.</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>SET</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Associates the specified object with the given key.</DESCRIPT>
    </SEOCOMPOTX>
   </DESCRIPTIONS>
   <DESCRIPTIONS_SUB>
    <SEOSUBCOTX>
     <CMPNAME>GET</CMPNAME>
     <SCONAME>KEY</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>The string key associated with the object.</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>GET</CMPNAME>
     <SCONAME>RESULT</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>The referenced object, or NULL if not available.</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>KEYS</CMPNAME>
     <SCONAME>RESULT</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Keys</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>REMOVE</CMPNAME>
     <SCONAME>KEY</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>The string key of the mapping to remove.</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>REMOVE</CMPNAME>
     <SCONAME>RESULT</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>true if removal was successful, false otherwise.</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>SET</CMPNAME>
     <SCONAME>KEY</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>The string key to associate with the object.</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>SET</CMPNAME>
     <SCONAME>OBJ</SCONAME>
     <LANGU>E</LANGU>
     <DESCRIPT>The object reference to store (may be NULL).</DESCRIPT>
    </SEOSUBCOTX>
   </DESCRIPTIONS_SUB>
  </asx:values>
 </asx:abap>
</abapGit>
